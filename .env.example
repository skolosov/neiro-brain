APP_NAME="Neiro Brain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://neiro-brain.local

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# OpenServer PostgreSQL usually listens on 127.0.1.46:5432.
DB_CONNECTION=pgsql
DB_HOST=127.0.1.46
DB_PORT=5432
DB_DATABASE=neiro_brain
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Neiro Brain -----------------------------------------------------------
# Single token for the proxy, MCP and the API. When set, it is accepted in all
# three scopes and the per-scope tokens below are not needed.
# BRAIN_TOKEN=

# Per-scope fallback tokens. After the first run they can be changed in the admin
# panel (they are encrypted at rest with APP_KEY).
BRAIN_PROXY_TOKEN=dev-proxy-token
BRAIN_MCP_TOKEN=dev-mcp-token
BRAIN_API_TOKEN=dev-api-token

# Demo admin created by `php artisan db:seed`.
BRAIN_ADMIN_EMAIL=admin@neiro-brain.local
BRAIN_ADMIN_PASSWORD=password

# false — прокси пускает только по токену Neiro Brain (в адресе или заголовке).
# true — пускает и по одному ключу провайдера (sk-…), без токена.
BRAIN_PROXY_OPEN=false

# Proxy upstream used before the settings row is edited in the admin panel:
# mock | openai | deepseek | openrouter | ollama | anthropic
BRAIN_PROXY_UPSTREAM=mock
BRAIN_PROXY_BASE_URL=

# Optional upstream keys if you prefer .env over the admin panel.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# MoonShine branding
MOONSHINE_TITLE="Neiro Brain"
